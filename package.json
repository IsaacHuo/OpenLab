{
  "name": "openlab-repository",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Repository governance and documentation tooling for OpenLab",
  "license": "Apache-2.0",
  "overrides": {
    "katex": "0.18.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "brand:generate": "node scripts/generate-brand.mjs",
    "check": "npm run lint:markdown && npm run check:repository && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "build": "vite build && node scripts/copy-pdf-assets.mjs",
    "test:browser": "playwright test",
    "lint:markdown": "markdownlint-cli2",
    "check:repository": "node scripts/check-repository.mjs",
    "test": "node --test scripts/tests/*.test.mjs app/tests/*.test.ts",
    "test:live-model": "node scripts/live-model-smoke.mjs",
    "test:live-research": "node scripts/live-research-smoke.mjs",
    "start": "node app/main.ts",
    "check:actions": "node scripts/tool.mjs actionlint",
    "check:secrets": "node scripts/tool.mjs gitleaks",
    "github:sync": "node scripts/github.mjs sync",
    "github:verify": "node scripts/github.mjs verify",
    "release:check": "node scripts/release.mjs check",
    "plugins:prepare": "node scripts/prepare-tex.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "markdownlint-cli2": "0.24.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@assistant-ui/react": "0.15.31",
    "@assistant-ui/react-ag-ui": "0.1.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "diff": "^9.0.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "yaml": "2.9.1"
  }
}
