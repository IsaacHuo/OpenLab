{
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".cache/**", ".openlab/**", "dist/**", "test-results/**", "playwright-report/**", "docs/vision.zh-CN.md"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["details", "summary", "br", "img", "p", "a", "picture", "source", "div"] },
    "MD060": false
  }
}
