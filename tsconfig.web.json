{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"], "allowImportingTsExtensions": true, "erasableSyntaxOnly": true
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "vite.config.ts"]
}
